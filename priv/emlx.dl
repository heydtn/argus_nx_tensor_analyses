// What EMLX computes differently from BinaryBackend and EXLA, and tensors
// of two backends that meet.
//
// EMLX runs Nx on Apple's MLX, on its CPU device or its GPU (Metal), and
// some of Nx comes out differently there. This program finds the calls
// where that shows, and reports two things:
//
//   * `tensor_emlx_divergence`: an Nx call EMLX computes differently
//     from BinaryBackend and EXLA: a tensor made in a type EMLX does not
//     have (f64, which it keeps as f32, and c128, which it keeps as c64);
//     a remainder whose divisor or dividend can be negative; an integer
//     power whose exponent can be negative; a round of a value the code's
//     math can put exactly on a half;
//   * `tensor_emlx_mixed_backends`: an Nx call that gets tensors of two
//     backends that cannot meet, such as one a function compiled with
//     EXLA returns and one made on EMLX, which Nx raises for.
//
// It reads the words of the tensor shapes program (`tensor_shapes.dl`,
// included below): its values and the contexts they are followed in,
// the signs a value can have (`may_have_sign`), where it lies against
// ±1 (`in_region`), what kind of number it is (`argument_class`), and the
// types tensors are made in (`given_type`). The calls this program asks
// about join that program's demand: a power, and what a round rounds,
// ask for their operands' signs and types as a division does.
//
// Which way it errs: a value the rules cannot follow gives no finding,
// as in the tensor shapes program, with two exceptions it says where it
// makes them: an operand that is negative only as an input may be is
// reported at a lower certainty (`certain` 0), and a function's backend
// is taken to be the one a compiler or `Nx.with_default_backend/2` runs
// it on wherever it is called (`runs_under`).

.include "tensor_shapes.dl"

// ══ Types EMLX does not have ════════════════════════════════════════
//
// EMLX has no 64-bit float and no 128-bit complex type: on either device
// it keeps an f64 tensor as f32 and a c128 one as c64, while the tensor
// still says f64 or c128. An f64 computation there is an f32 one (0.1
// reads back as 0.10000000149011612, and 1 + 1.0e-10 as 1.0), and a c128
// tensor raises when read back.

// A call that makes a tensor, on EMLX, of a type EMLX does not have, and
// that the tensor shapes analysis is not already told to report.
.decl narrowed_type(context: Context, site: symbol, name: symbol)
narrowed_type(context, site, name) :-
  makes_type_emlx_lacks(context, site, name),
  !made_off_emlx(context, site),
  !reported_as_unsupported(name).

// ── Words ──────────────────────────────────────────────────────────

// A call in a context given a type EMLX does not have: not one whose
// options Nx rejects, which raises before it makes a tensor.
.decl makes_type_emlx_lacks(context: Context, site: symbol, name: symbol)
makes_type_emlx_lacks(context, site, name) :-
  given_type(context, site, name, _),
  lacked_by_emlx(name),
  !rejected_options(context, site, _, _).

.decl lacked_by_emlx(name: symbol)
lacked_by_emlx("f64"). lacked_by_emlx("c128").

// The type of every call given one is asked, as the tensor shapes
// program asks it where the backend is said to lack some type.
type_asked(context, site) :- type_given(site), site_active(context, site).

// A call that makes its tensor on a backend other than EMLX: its
// `backend:` option names another, it runs in a function a compiler for
// another backend runs or `Nx.with_default_backend/2` runs on another,
// it converts a tensor that is on another, or it is given no backend
// and the code sets another as the default. Where a function runs on
// EMLX too (called directly as well as through an EXLA jit), its calls
// are taken to be off EMLX: it errs quiet there.
.decl made_off_emlx(context: Context, site: symbol)
made_off_emlx(context, site) :-
  makes_type_emlx_lacks(context, site, _),
  creates_on_default(site),
  !default_backend("EMLX.Backend").
made_off_emlx(context, site) :-
  makes_type_emlx_lacks(context, site, _),
  places_on(site, backend, _),
  backend != "EMLX.Backend".
made_off_emlx(context, site) :-
  makes_type_emlx_lacks(context, site, _),
  site_function(site, function),
  runs_under(function, backend),
  backend != "EMLX.Backend".
made_off_emlx(context, site) :-
  makes_type_emlx_lacks(context, site, _),
  site_function(site, function),
  argument_source(site, function, 0, kind, source),
  placed_on(context, function, kind, source, backend, _),
  backend != "EMLX.Backend".

// A tensor of a type EMLX does not have that a transfer or copy moves
// onto EMLX (`origin` the call that makes it that type): EMLX keeps an
// f64 as f32 while the tensor still says f64, and raises taking a c128
// in. A tensor made on EMLX in that type is that call's finding.
.decl narrowed_transfer(context: Context, site: symbol, name: symbol, origin: symbol)
narrowed_transfer(context, site, name, origin) :-
  moved_to_emlx(context, site, function, kind, source),
  value_dtype(context, function, kind, source, type, origin),
  type_instance(type, name),
  lacked_by_emlx(name),
  !narrowed_type(_, origin, _).

// A tensor `Nx.backend_transfer/2` or `Nx.backend_copy/2` moves onto
// EMLX, as a source of the function that moves it, in a context: the
// values whose types are asked.
.decl moved_to_emlx(context: Context, site: symbol, function: symbol, kind: symbol, source: symbol)
moved_to_emlx(context, site, function, kind, source) :-
  transfers_backend(site),
  places_on(site, "EMLX.Backend", site),
  site_active(context, site),
  argument_source(site, function, 0, kind, source).
dtype_demand(context, function, kind, source) :- moved_to_emlx(context, _, function, kind, source).

// The tensor shapes analysis reports every call that makes a type the
// backend is said to lack (its `unsupported_types` option), so a type
// the project lists there is left to it, and not reported twice.
.decl reported_as_unsupported(name: symbol)
reported_as_unsupported(name) :- unsupported_type(name).

// ══ Remainders of negative numbers ══════════════════════════════════
//
// EMLX computes a remainder as MLX's, which takes the divisor's sign (a
// floored remainder), then subtracts the divisor where the dividend is
// negative, to give the result the dividend's sign as Nx does. That is
// right only where the divisor is positive and the division is not
// exact: remainder(-7, 3) is -1, but remainder(-6, 2) is -2 rather than
// 0, remainder(7, -2) is -1 rather than 1, and remainder(-7, -3) is 2
// rather than -1. EMLX's compiler computes the same.

// A remainder whose divisor or dividend can be negative.
.decl negative_remainder(context: Context, site: symbol, operand: symbol, certain: number, origin: symbol, cause: symbol)
negative_remainder(context, site, "dividend", certain, origin, cause) :-
  takes_remainder(site),
  operand_can_be_negative(context, site, 0, certain, origin, cause).
negative_remainder(context, site, "divisor", certain, origin, cause) :-
  takes_remainder(site),
  operand_can_be_negative(context, site, 1, certain, origin, cause).

// ── Words ──────────────────────────────────────────────────────────

.decl takes_remainder(site: symbol)
takes_remainder(site) :- operation_site(site, operation, 2), nx_class(operation, "sign", "remainder").

// An argument asked about that can be negative: because of the code's
// own math (`certain` 1), with the call whose math makes it so
// (`origin`, "" for a written number) and how (`cause`: the number
// written as the argument, else as `lowered_by_math` names it), or only
// as an input the rules do not follow can be (`certain` 0, "input").
.decl operand_can_be_negative(context: Context, site: symbol, position: number, certain: number, origin: symbol, cause: symbol)
operand_can_be_negative(context, site, position, 1, origin, text) :-
  negative_by_math(context, site, position, "literal", text, origin, _).
operand_can_be_negative(context, site, position, 1, origin, cause) :-
  negative_by_math(context, site, position, kind, _, origin, cause),
  kind != "literal".
operand_can_be_negative(context, site, position, 0, "", "input") :-
  divergence_negative_asked(site, position),
  argument_sign(context, site, position, "negative", _, _),
  !negative_by_math(context, site, position, _, _, _, _).

// A value reaching the argument (`kind`, `source`) that can be negative,
// and can lie at or below -1 because of the code's own math
// (`in_region`): a written number, or a call whose math puts it there,
// and how, as `lowered_by_math` names it.
.decl negative_by_math(context: Context, site: symbol, position: number, kind: symbol, source: symbol, origin: symbol, cause: symbol)
negative_by_math(context, site, position, kind, source, origin, named) :-
  divergence_negative_asked(site, position),
  signed_argument(context, site, position, function, kind, source),
  may_have_sign(context, function, kind, source, "negative", _, _),
  in_region(context, function, kind, source, region, origin, cause),
  region_order(region, order),
  order <= 1,
  lowered_by_math(cause, origin, named).

// A cause of a region at or below -1, with the call it names, that is
// the code's own math (`made_by_math`), named as it is; and, for a call
// the region rules do not follow ("unbounded"), a difference whose first
// operand the code's math lets be zero, as an index minus a number,
// named "subtract". A difference of two inputs, or of two sizes, is
// negative only as inputs are.
.decl lowered_by_math(cause: symbol, origin: symbol, named: symbol)
lowered_by_math(cause, origin, cause) :-
  negative_cause(cause, origin),
  made_by_math(cause).
lowered_by_math("unbounded", origin, "subtract") :-
  negative_cause("unbounded", origin),
  sign_rule(origin, "subtract"),
  argument_sign(_, origin, 0, "zero", _, cause),
  made_by_math(cause).

// The causes, and the calls they name, of the regions at or below -1
// the arguments asked about can be in.
.decl negative_cause(cause: symbol, origin: symbol)
negative_cause(cause, origin) :-
  divergence_negative_asked(site, position),
  signed_argument(context, site, position, function, kind, source),
  in_region(context, function, kind, source, region, origin, cause),
  region_order(region, order),
  order <= 1.

// The arguments whose negative values the rules ask about: a
// remainder's operands and a power's exponent.
.decl divergence_negative_asked(site: symbol, position: number)
divergence_negative_asked(site, 0) :- takes_remainder(site).
divergence_negative_asked(site, 1) :- takes_remainder(site).
divergence_negative_asked(site, 1) :- sign_rule(site, "power").

// ══ Integer powers with negative exponents ══════════════════════════
//
// An integer raised to a negative integer power runs forever on EMLX's
// CPU device when run eagerly, and gives 0 on its GPU and under its
// compiler, for a base of 1 too. EXLA gives 0 (1 for a base of 1), and
// BinaryBackend raises.

// A power whose base and exponent can both be integers, and whose
// exponent can be negative.
.decl hanging_integer_power(context: Context, site: symbol, certain: number, origin: symbol, cause: symbol)
hanging_integer_power(context, site, certain, origin, cause) :-
  integer_power(context, site),
  operand_can_be_negative(context, site, 1, certain, origin, cause).

// ── Words ──────────────────────────────────────────────────────────

// A power asks for its operands' signs and types, as a division does.
sign_site(context, site) :- sign_rule(site, "power"), site_active(context, site).

// ══ Rounding halves ═════════════════════════════════════════════════
//
// EMLX rounds a value exactly halfway between two integers to the even
// one (0.5 to 0, 2.5 to 2), as MLX does, eager or compiled; BinaryBackend
// and EXLA round it away from zero (to 1 and 3). They agree everywhere
// else, so only a round of a value that can land on a half is reported:
// most values a round meets are measurements, which fall exactly on a
// half only by chance, and a note on every round would bury the rounds
// whose operands the code puts on halves: an integer halved, a mean of
// integers, an integer plus a half.

// A round of a value the code's math can put exactly on a half.
.decl rounds_half(context: Context, site: symbol, cause: symbol, origin: symbol, how: symbol)
rounds_half(context, site, cause, origin, how) :-
  rounds_to_nearest(site),
  rounded_operand(site, origin),
  lands_on_half(context, origin, cause, how).

// ── Words ──────────────────────────────────────────────────────────

.decl rounds_to_nearest(site: symbol)
rounds_to_nearest(site) :- operation_site(site, "Nx.round", 1).

// The Nx call whose result a round rounds.
.decl rounded_operand(site: symbol, operand: symbol)
rounded_operand(site, operand) :-
  rounds_to_nearest(site),
  argument_source(site, _, 0, "result", operand),
  operation_site(operand, _, _).

// An Nx call whose result can lie exactly on a half: an integer divided
// by a written even number, or times a written half ("halved"); an
// integer plus or minus a written half ("half_added"); a mean of
// integers, which lies on a half where it averages an even number of
// them ("mean"). `how` is the call's sign class and the number written
// (`divide 2`, `add 0.5`), empty for a mean.
.decl lands_on_half(context: Context, site: symbol, cause: symbol, how: symbol)
lands_on_half(context, site, "halved", cat("divide ", text)) :-
  rounded_operand(_, site),
  sign_rule(site, "divide"),
  written_operand(site, 1, text),
  written_number(text, "parity", "even"),
  argument_class(context, site, 0, "integer", _).
lands_on_half(context, site, "halved", cat("multiply ", text)) :-
  rounded_operand(_, site),
  sign_rule(site, "multiply"),
  written_operand(site, written, text),
  written_number(text, "fraction", "half"),
  written <= 1,
  argument_class(context, site, 1 - written, "integer", _).
lands_on_half(context, site, "half_added", cat(class, " ", text)) :-
  rounded_operand(_, site),
  sign_rule(site, class),
  ( class = "add" ; class = "subtract" ),
  written_operand(site, written, text),
  written_number(text, "fraction", "half"),
  written <= 1,
  argument_class(context, site, 1 - written, "integer", _).
lands_on_half(context, site, "mean", "") :-
  rounded_operand(_, site),
  operation_site(site, "Nx.mean", _),
  argument_class(context, site, 0, "integer", _).

// What a round rounds asks for its operands' types, as a division does.
sign_site(context, site) :- rounded_operand(_, site), site_active(context, site).

// A number written as the argument at `position`.
.decl written_operand(site: symbol, position: number, text: symbol)
written_operand(site, position, text) :-
  rounded_operand(_, site),
  argument_source(site, _, position, "literal", text).

// ══ Shifts past the width EMLX shifts in ════════════════════════════
//
// EMLX shifts an integer of 32 bits or fewer (but u32) in 32 bits, and
// u32 and the 64-bit integers in 64, and takes the amount modulo that
// width, on either device and under its compiler: left_shift(1, 33) of an
// s32 is 2 and left_shift(1, 32) is 1 on EMLX, where BinaryBackend and
// EXLA shift every bit out and give 0 (-1 for a negative number shifted
// right). A narrower type shifted by its own width or more, but less than
// 32, gives 0 on all three.

// A shift by a written amount at or past the width EMLX shifts its type
// in, which EMLX wraps around.
.decl wrapped_shift(context: Context, site: symbol, type: symbol, amount: symbol)
wrapped_shift(context, site, type, amount) :-
  shifts_bits(site),
  call_type(context, site, type, _),
  argument_number(context, site, 1, amount),
  reaches_shift_width(amount, type).

// ── Words ──────────────────────────────────────────────────────────

.decl shifts_bits(site: symbol)
shifts_bits(site) :- operation_site(site, operation, 2), nx_trait(operation, "shifts_bits").

nx_members("trait", "shifts_bits", " Nx.left_shift Nx.right_shift Nx.Defn.Kernel.<<< Nx.Defn.Kernel.>>> ").

// A written amount at or past the width EMLX shifts an integer type in:
// 64 bits for u32 and the 64-bit types, and 32 for the others, which it
// widens.
.decl reaches_shift_width(amount: symbol, type: symbol) inline
reaches_shift_width(amount, type) :-
  number_value(amount, value),
  nx_dtype(type, _, 64, "integer"),
  value >= 64.
reaches_shift_width(amount, "u32") :- number_value(amount, value), value >= 64.
reaches_shift_width(amount, type) :-
  number_value(amount, value),
  nx_dtype(type, _, size, "integer"),
  size <= 32,
  type != "u32",
  value >= 32.

// ══ Tensors of two backends ═════════════════════════════════════════
//
// Nx raises (`Nx.Defn.IncompatibleBackendsError`) when a call gets
// tensors of two backends, unless one of them is Nx.BinaryBackend, which
// any other takes in: an EXLA tensor and an EMLX tensor cannot meet. A
// function compiled with EXLA returns EXLA tensors whatever it is
// handed, so its results meet the project's EMLX tensors only after
// `Nx.backend_transfer/2`.
//
// A tensor's backend is followed where the code chooses one: a creation
// call's `backend:` option, a transfer or copy to a backend, what a
// function a compiler compiled returns, and what
// `Nx.with_default_backend/2` returns. It is followed forward from
// those calls, as values are followed (through Nx calls, returns,
// arguments, and the fields of containers and of terms the code builds),
// and where it meets another tensor, that tensor's backend is asked: the
// default backend where a creation call given none makes it. The
// default backend is the one the code sets with `Nx.default_backend/1`,
// and EMLX's where it sets none. A tensor whose backend is not followed
// meets nothing (it errs quiet). The calls in code Nx traces (a `defn`,
// or a function handed to a jit, a compile or a grad, `runs_in_trace`)
// build an expression, and whether they mix backends is the compiler's:
// EMLX's and EXLA's move the arguments to their own backend, and the
// evaluator runs the calls as eager ones do. Which compiler runs a
// `defn` called directly, or a trace given none, is configured outside
// the code, so they are not reported (it errs quiet there).

// An Nx call run eagerly gets two tensors whose backends cannot meet.
.decl mixed_backends(context: Context, site: symbol, backend: symbol, operand: symbol, origin: symbol, other: symbol, other_operand: symbol, other_origin: symbol)
mixed_backends(context, site, backend, operand, origin, other, other_operand, other_origin) :-
  operands_on(context, site, backend, operand, origin, other, other_operand, other_origin),
  backends_conflict(backend, other),
  site_function(site, function),
  !runs_in_trace(function).

// ── Where the code puts a tensor ───────────────────────────────────

// A call whose result is on `backend`, and the call that chooses it
// (`origin`): the call itself, or the compile whose function it runs.
// Nx.BinaryBackend is never one: it meets any backend.
.decl places_on(site: symbol, backend: symbol, origin: symbol)
places_on(site, backend, site) :-
  creates_tensor(site),
  option(site, "backend", text, start),
  backend_spelling(text, start, backend).
places_on(site, backend, site) :-
  creates_tensor(site),
  !option_given(site, "backend"),
  site_function(site, function),
  runs_under(function, backend).
places_on(site, backend, site) :-
  transfers_backend(site),
  argument_source(site, _, 1, "literal", text),
  backend_spelling(text, 0, backend).
places_on(site, backend, site) :-
  remote_call(site, _, "Nx", "with_default_backend", 2),
  argument_source(site, _, 0, "literal", text),
  backend_spelling(text, 0, backend).
places_on(site, backend, site) :- compiles_for(site, backend, "runs").
places_on(call, backend, site) :-
  compiles_for(site, backend, "returns"),
  flow_callee(call, _, "fun", "result", site).

// The calls that make a tensor from data, a shape or a seed, on the
// default backend or the one their `backend:` option names: those that
// make one of no tensor, and Nx's constants.
.decl creates_tensor(site: symbol)
creates_tensor(site) :- operation_site(site, operation, _), nx_trait(operation, "creates").
creates_tensor(site) :- remote_call(site, _, "Nx.Constants", _, _).

// A transfer or copy of a tensor to the backend its second argument
// names.
.decl transfers_backend(site: symbol)
transfers_backend(site) :- operation_site(site, "Nx.backend_transfer", 2).
transfers_backend(site) :- operation_site(site, "Nx.backend_copy", 2).

// A backend as the code writes it: its module, or the module and its
// options in a tuple.
.decl written_backend(text: symbol, start: number, backend: symbol)
written_backend(text, start, backend) :- term_module(text, start, backend).
written_backend(text, start, backend) :-
  term_tuple(text, start),
  term_child(text, start, 0, child),
  term_module(text, child, backend).

// Such a backend, but Nx.BinaryBackend, which meets any other and is not
// followed.
.decl backend_spelling(text: symbol, start: number, backend: symbol)
backend_spelling(text, start, backend) :-
  written_backend(text, start, backend),
  backend != "Nx.BinaryBackend".

// A call that compiles a function with a compiler whose results are on
// its backend, and whether the call runs it ("runs": `jit_apply`) or
// returns the compiled function ("returns": `jit`, `compile`). A
// compiler given as an option must be written.
.decl compiles_for(site: symbol, backend: symbol, how: symbol)
compiles_for(site, backend, how) :-
  compile_call(site, how),
  option(site, "compiler", text, start),
  term_module(text, start, compiler),
  compiler_backend(compiler, backend).
compiles_for(site, "EXLA.Backend", "returns") :- remote_call(site, _, "EXLA", "jit", _).
compiles_for(site, "EXLA.Backend", "returns") :- remote_call(site, _, "EXLA", "compile", _).
compiles_for(site, "EXLA.Backend", "runs") :- remote_call(site, _, "EXLA", "jit_apply", _).

// `Nx.Defn`'s functions that compile the function they are handed with
// the `:compiler` their options name.
.decl compile_call(site: symbol, how: symbol)
compile_call(site, "returns") :- remote_call(site, _, "Nx.Defn", "jit", 2).
compile_call(site, "returns") :- remote_call(site, _, "Nx.Defn", "compile", 3).
compile_call(site, "runs") :- remote_call(site, _, "Nx.Defn", "jit_apply", 3).

// The backend a compiler's results are on.
.decl compiler_backend(compiler: symbol, backend: symbol)
compiler_backend("EXLA", "EXLA.Backend").
compiler_backend("EMLX", "EMLX.Backend").

// A function that runs on `backend`: one a compiler for it compiles, one
// `Nx.with_default_backend/2` runs on it, and what they call.
.decl runs_under(function: symbol, backend: symbol)
runs_under(function, backend) :- backend_reach.reaches(backend, function).

.init backend_reach = ForwardCallReach
backend_reach.root(backend, function) :-
  compiles_for(site, backend, _),
  fun_argument(site, 0, function, _).
backend_reach.root(backend, function) :-
  remote_call(site, _, "Nx", "with_default_backend", 2),
  argument_source(site, _, 0, "literal", text),
  backend_spelling(text, 0, backend),
  fun_argument(site, 1, function, _).

// The backend a creation call given none makes its tensor on: the one
// the code sets as the default, or EMLX's, which this analysis is for,
// where it sets none.
.decl default_backend(backend: symbol)
default_backend(backend) :- sets_default_backend(_, backend).
default_backend("EMLX.Backend") :- !sets_default_backend(_, _).

.decl sets_default_backend(site: symbol, backend: symbol)
sets_default_backend(site, backend) :-
  remote_call(site, _, "Nx", name, 1),
  ( name = "default_backend" ; name = "global_default_backend" ),
  argument_source(site, _, 0, "literal", text),
  written_backend(text, 0, backend).

// ── Where a tensor goes ────────────────────────────────────────────

// A value in a context can be a tensor on `backend`, put there by
// `origin`: followed forward from the calls that choose a backend.
.decl placed_on(context: Context, function: symbol, kind: symbol, source: symbol, backend: symbol, origin: symbol)
placed_on(context, function, "result", site, backend, origin) :-
  places_on(site, backend, origin),
  site_function(site, function),
  site_active(context, site).

// An Nx call's result is on its tensor operands' backend.
placed_on(context, function, "result", site, backend, origin) :-
  placed_on(context, function, kind, source, backend, origin),
  tensor_argument(site, function, _, kind, source),
  keeps_backend(site),
  site_active(context, site).

// A value that arrives across a call (`arrives_from`): where the value it
// arrives from is.
placed_on(context, function, kind, source, backend, origin) :-
  placed_on(from_context, from_function, from_kind, from_source, backend, origin),
  arrives_from(context, function, kind, source, from_context, from_function, from_kind, from_source).

// A field of a container on a backend, which a compile or a transfer
// moves as a whole, and what a lookup finds in one.
placed_on(context, function, "load", load, backend, origin) :-
  placed_on(context, function, kind, source, backend, origin),
  flow_load(function, load, _, kind, source).
placed_on(context, function, "result", site, backend, origin) :-
  placed_on(context, function, kind, source, backend, origin),
  argument_source(site, function, 0, kind, source),
  lookup_site(site).

// A field of a term the code builds, read where the term is.
placed_on(context, function, "load", load, backend, origin) :-
  placed_on(object_context, builder, field_kind, field_source, backend, origin),
  flow_field(builder, object, selector, field_kind, field_source),
  value_of(context, function, kind, source, $Object(object_context, object, _)),
  flow_load(function, load, selector, kind, source).

// ── What another tensor it meets is on ─────────────────────────────

// A call in a context that gets a tensor whose backend is followed.
.decl meets_placed(context: Context, site: symbol)
meets_placed(context, site) :-
  placed_on(context, function, kind, source, _, _),
  tensor_argument(site, function, _, kind, source),
  site_active(context, site).

// The values whose default backend is asked: the tensors such a call
// gets, then what they are made of, as `placed_on` follows them.
.decl default_demand(context: Context, function: symbol, kind: symbol, source: symbol)
default_demand(context, function, kind, source) :-
  meets_placed(context, site),
  tensor_argument(site, function, _, kind, source).
default_demand(context, function, kind, source) :-
  default_demand(context, function, "result", site),
  keeps_backend(site),
  tensor_argument(site, function, _, kind, source).
default_demand(from_context, from_function, from_kind, from_source) :-
  default_demand(context, function, kind, source),
  arrives_from(context, function, kind, source, from_context, from_function, from_kind, from_source).
default_demand(object_context, builder, field_kind, field_source) :-
  default_demand(context, function, "load", load),
  flow_load(function, load, selector, kind, source),
  value_of(context, function, kind, source, $Object(object_context, object, _)),
  flow_field(builder, object, selector, field_kind, field_source).

// A value asked about can be a tensor made on the default backend, by
// `origin`: a creation call given no backend, outside any function that
// runs on a backend of its own.
.decl made_on_default(context: Context, function: symbol, kind: symbol, source: symbol, origin: symbol)
made_on_default(context, function, "result", site, site) :-
  default_demand(context, function, "result", site),
  creates_on_default(site).
made_on_default(context, function, "result", site, origin) :-
  made_on_default(context, function, kind, source, origin),
  tensor_argument(site, function, _, kind, source),
  keeps_backend(site),
  default_demand(context, function, "result", site).
made_on_default(context, function, kind, source, origin) :-
  made_on_default(from_context, from_function, from_kind, from_source, origin),
  arrives_from(context, function, kind, source, from_context, from_function, from_kind, from_source),
  default_demand(context, function, kind, source).
made_on_default(context, function, "load", load, origin) :-
  made_on_default(object_context, builder, field_kind, field_source, origin),
  flow_field(builder, object, selector, field_kind, field_source),
  value_of(context, function, kind, source, $Object(object_context, object, _)),
  flow_load(function, load, selector, kind, source),
  default_demand(context, function, "load", load).

// A creation call given no backend, outside any function that runs on a
// backend of its own, and not handed a tensor whose backend is followed,
// which `Nx.tensor/2` hands back as it is.
.decl creates_on_default(site: symbol)
creates_on_default(site) :-
  creates_tensor(site),
  !option_given(site, "backend"),
  site_function(site, function),
  !runs_under(function, _),
  !handed_placed_tensor(site).

.decl handed_placed_tensor(site: symbol)
handed_placed_tensor(site) :-
  creates_tensor(site),
  tensor_argument(site, function, _, kind, source),
  placed_on(_, function, kind, source, _, _).

// The backends of two tensors a call gets, which operands they are
// (`tensor_argument`), and the calls that put them there, but a backend
// a tensor has only as part of a mix it carries from an earlier call,
// which is that call's finding.
.decl operands_on(context: Context, site: symbol, backend: symbol, operand: symbol, origin: symbol, other: symbol, other_operand: symbol, other_origin: symbol)
operands_on(context, site, backend, operand, origin, other, other_operand, other_origin) :-
  operand_on(context, site, operand, backend, origin),
  operand_on(context, site, other_operand, other, other_origin),
  operand != other_operand.

.decl operand_on(context: Context, site: symbol, operand: symbol, backend: symbol, origin: symbol)
operand_on(context, site, operand, backend, origin) :-
  operand_placed(context, site, operand, kind, source, backend, origin),
  site_function(site, function),
  !carries_mix(context, function, kind, source, origin).

// A tensor a call gets can be on `backend`, put there by `origin`:
// followed forward, or made on the default backend.
.decl operand_placed(context: Context, site: symbol, operand: symbol, kind: symbol, source: symbol, backend: symbol, origin: symbol)
operand_placed(context, site, operand, kind, source, backend, origin) :-
  meets_placed(context, site),
  tensor_argument(site, function, operand, kind, source),
  placed_on(context, function, kind, source, backend, origin).
operand_placed(context, site, operand, kind, source, backend, origin) :-
  meets_placed(context, site),
  tensor_argument(site, function, operand, kind, source),
  made_on_default(context, function, kind, source, origin),
  default_backend(backend).

// A call that gets two tensors whose backends cannot meet, one of them
// put on its backend by `origin`.
.decl mixing_call(context: Context, site: symbol, origin: symbol)
mixing_call(context, site, origin) :-
  operand_placed(context, site, operand, _, _, backend, origin),
  operand_placed(context, site, other_operand, _, _, other, _),
  operand != other_operand,
  backends_conflict(backend, other).
mixing_call(context, site, other_origin) :-
  operand_placed(context, site, operand, _, _, backend, _),
  operand_placed(context, site, other_operand, _, _, other, other_origin),
  operand != other_operand,
  backends_conflict(backend, other).

// A value that carries `origin`'s tensor mixed with one it cannot meet:
// the result of a call that mixes them, and what Nx calls, returns and
// the program's calls make of it. Nx raises at the first such call, so
// only that call is reported.
.decl carries_mix(context: Context, function: symbol, kind: symbol, source: symbol, origin: symbol)
carries_mix(context, function, "result", site, origin) :-
  mixing_call(context, site, origin),
  site_function(site, function).
carries_mix(context, function, "result", site, origin) :-
  carries_mix(context, function, kind, source, origin),
  tensor_argument(site, function, _, kind, source),
  keeps_backend(site),
  site_active(context, site).
carries_mix(context, function, kind, source, origin) :-
  carries_mix(from_context, from_function, from_kind, from_source, origin),
  arrives_from(context, function, kind, source, from_context, from_function, from_kind, from_source).

// Two backends whose tensors cannot meet, the first not EMLX's: any two
// the code names, but Nx.BinaryBackend, which meets any other.
.decl backends_conflict(backend: symbol, other: symbol)
backends_conflict(backend, other) :-
  named_backend(backend),
  named_backend(other),
  backend != other,
  backend != "EMLX.Backend",
  backend != "Nx.BinaryBackend",
  other != "Nx.BinaryBackend".

.decl named_backend(backend: symbol)
named_backend(backend) :- places_on(_, backend, _).
named_backend(backend) :- default_backend(backend).

// ── Which calls follow a tensor ────────────────────────────────────

// A tensor an Nx call gets, and which of its operands it is (`operand`):
// the argument at a position, or an element of a list the function
// builds for one (`Nx.concatenate/2`, `Nx.stack/2`), named by its cell.
// A tensor given for its shape (`Nx.broadcast/2`'s second argument,
// `Nx.iota/2`'s first) is not one: Nx reads only its shape.
.decl tensor_argument(site: symbol, function: symbol, operand: symbol, kind: symbol, source: symbol)
tensor_argument(site, function, to_string(position), kind, source) :-
  operation_site(site, _, _),
  argument_source(site, function, position, kind, source),
  !shape_position(site, position).
tensor_argument(site, function, cat(to_string(position), " ", cell), kind, source) :-
  operation_site(site, _, _),
  argument_source(site, function, position, "object", list),
  list_cell(list, _, cell),
  flow_field(function, cell, "head", kind, source).
list_asked(list) :- operation_site(site, _, _), argument_source(site, _, _, "object", list).

// An Nx call whose result is a tensor on its operands' backend: every
// one but those that choose a backend, and those that return a number,
// a list, a binary or a description of a tensor.
.decl keeps_backend(site: symbol)
keeps_backend(site) :-
  operation_site(site, operation, _),
  !nx_trait(operation, "leaves_backend").

// The calls whose result is no tensor on their operands' backend: those
// that answer about a tensor's shape or struct, give a template or the
// data on the host, move a tensor to another backend, or answer about or
// change the backend.
nx_trait(operation, "leaves_backend") :- nx_class(operation, "gives", gives), in_set("leaves_backend", gives).
nx_members("set", "leaves_backend", " shape struct template host moved backend ").

// ══ Findings ════════════════════════════════════════════════════════

// An Nx call EMLX computes differently from BinaryBackend and EXLA.
// `kind` names what: "narrowed_type" (`detail`, the type: f64 or c128),
// "narrowed_transfer" (`detail`, the type of a tensor moved onto EMLX),
// "negative_remainder" (`detail`, the operand that can be negative:
// divisor or dividend), "negative_integer_power" (`detail`, "exponent"),
// "round_half" (`detail`, how the operand lands on a half: halved,
// half_added, mean), or "wrapped_shift" (`detail`, the type and the
// amount: `s32 33`). `certain` is 1 where the code's own math causes
// it, 0 where only an input may; `cause` is how, where a finding shows
// it: how a negative operand is negative (its number where it is
// written, `-1`, else `subtract`, `input`, ...), and the class and
// number that put a round's operand on a half (`divide 2`); `origin` is
// the call whose math does, "" for none or a written number.
.decl emlx_divergence(context: Context, site: symbol, kind: symbol, detail: symbol, certain: number, cause: symbol, origin: symbol)
emlx_divergence(context, site, "narrowed_type", name, 1, "", "") :- narrowed_type(context, site, name).
emlx_divergence(context, site, "narrowed_transfer", name, 1, "", origin) :-
  narrowed_transfer(context, site, name, origin).
emlx_divergence(context, site, "negative_remainder", operand, certain, cause, origin) :-
  negative_remainder(context, site, operand, certain, origin, cause).
emlx_divergence(context, site, "negative_integer_power", "exponent", certain, cause, origin) :-
  hanging_integer_power(context, site, certain, origin, cause).
emlx_divergence(context, site, "round_half", cause, 1, how, origin) :-
  rounds_half(context, site, cause, origin, how).
emlx_divergence(context, site, "wrapped_shift", cat(type, " ", amount), 1, "", "") :-
  wrapped_shift(context, site, type, amount).

// The most certain of a finding's rows, in any context.
.decl divergence_certainty(site: symbol, kind: symbol, detail: symbol, certain: number)
divergence_certainty(site, kind, detail, certain) :-
  emlx_divergence(_, site, kind, detail, _, _, _),
  certain = max value : { emlx_divergence(_, site, kind, detail, value, _, _) }.

.decl tensor_emlx_divergence(id: symbol, func: symbol, operation: symbol, kind: symbol, detail: symbol, certain: number, cause: symbol, origin: symbol, origin_operation: symbol)
.output tensor_emlx_divergence
tensor_emlx_divergence(site, function, operation, kind, detail, certain, cause, origin, origin_operation) :-
  emlx_divergence(_, site, kind, detail, certain, cause, origin),
  divergence_certainty(site, kind, detail, certain),
  finding_call(site, function, operation),
  call_spelled(origin, origin_operation).
named_call(site) :- emlx_divergence(_, site, _, _, _, _, _).
named_call(origin) :- emlx_divergence(_, _, _, _, _, _, origin).

// A tensor on another backend than EMLX's (`backend`, the operand
// `operand`, put there by `origin`) and a tensor it cannot meet
// (`other`, the operand `other_operand`, put there by `other_origin`),
// both handed to one Nx call.
.decl tensor_emlx_mixed_backends(id: symbol, func: symbol, operation: symbol, backend: symbol, operand: symbol, origin: symbol, origin_operation: symbol, other: symbol, other_operand: symbol, other_origin: symbol, other_origin_operation: symbol)
.output tensor_emlx_mixed_backends
tensor_emlx_mixed_backends(site, function, operation, backend, operand, origin, origin_operation, other, other_operand, other_origin, other_origin_operation) :-
  mixed_backends(_, site, backend, operand, origin, other, other_operand, other_origin),
  finding_call(site, function, operation),
  call_spelled(origin, origin_operation),
  call_spelled(other_origin, other_origin_operation).
named_call(site) :- mixed_backends(_, site, _, _, _, _, _, _).
named_call(origin) :- mixed_backends(_, _, _, _, origin, _, _, _).
named_call(origin) :- mixed_backends(_, _, _, _, _, _, _, origin).
