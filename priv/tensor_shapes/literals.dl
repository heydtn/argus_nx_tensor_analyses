// Literals Nx reads differently than written: integers past s32, type names `Nx.Type` does not take.
//
// Included by `priv/tensor_shapes.dl`, whose words these rules build on.
//
// What it reports, each as a `tensor_type_error`:
//
//   * an integer literal outside s32 where Nx makes a tensor of it
//     without a type: `Nx.Type.infer/1` gives every integer s32, and Nx
//     types a literal operand before the result widens, so
//     `Nx.add(s64_tensor, 1_700_000_000_000)` adds -807049216;
//   * a type written as a short atom (`:f32`) where Nx matches only the
//     tuple form (`{:f, 32}`): most of `Nx.Type`'s functions, and the
//     `:type` of `Nx.Random.gumbel/2`, which hands it to one;
//   * a type Nx does not have (`:float32`, `{:f, 128}`), wherever a type
//     is given;
//   * literal data made into a tensor of a type written at the same call
//     that cannot hold it: an integer wraps, a float overflows to
//     infinity or flushes to zero, and a float, NaN or infinity in an
//     integer type raises.
//
// Souffle's numbers are 32 bits, so an integer that may not fit one is
// compared by its spelling (digit strings of one length compare as their
// numbers do), and a float by patterns over its spelling. Errs quiet: a
// value the rules do not hold as a term is not checked (one read at run
// time, or from a map the compiler keeps as a literal, which the term
// parser does not read), and a float within a few parts in ten million
// of a type's limit is taken to fit.

// ══ Reported ════════════════════════════════════════════════════════

// Each finding as a `tensor_type_error`, always certain, from no other
// call. `subject` is the literal as written, with the type Nx makes it in
// for the literal kinds (`300 as u8`); `position` is the argument it is
// in, -1 for an option.
tensor_type_error(site, function, operation, kind, subject, position, 1, "", "") :-
  literal_misread(site, kind, subject, position),
  call_named(site, operation),
  site_function(site, function).

// What goes wrong, by kind:
//
//   * "integer_past_s32": an integer literal outside s32 that Nx makes a
//     tensor of as s32, and wraps (EMLX saturates a scalar);
//   * "atom_type_rejected": a short atom type where a function raises
//     for it (FunctionClauseError, or an ArgumentError from the function
//     it hands the atom to);
//   * "atom_type_misread": a short atom type where a catch-all clause
//     answers as for another type (`Nx.Type.to_complex(:f64)` is
//     `{:c, 64}`), listed only for the types it answers wrongly;
//   * "invalid_type": a type Nx does not have, which raises;
//   * "literal_wraps", "literal_overflows", "literal_flushes",
//     "float_as_integer": literal data the type written at the call
//     cannot hold (`number_misfit`).
//
// A literal with several values a type cannot hold is reported at the
// first of them.
.decl literal_misread(site: symbol, kind: symbol, subject: symbol, position: number)
literal_misread(site, kind, cat(spelled, " as ", name), position) :-
  literal_outside_type(site, position, kind, text, _, name),
  first = min start : { literal_outside_type(site, position, kind, text, start, name) },
  term_spelling(text, first, spelled).
literal_misread(site, kind, spelled, position) :- atom_type_handed(site, position, spelled, kind).
literal_misread(site, "invalid_type", spelled, position) :- invalid_type(site, position, spelled).

// A call as a finding names it: `Nx.add/2`, `Nx.Type.float?/1`.
.decl call_named(site: symbol, operation: symbol)
call_named(site, cat(module, ".", name, "/", to_string(arity))) :-
  literal_misread(site, _, _, _),
  remote_call(site, _, module, name, arity).

// ══ Literals a type cannot hold ═════════════════════════════════════

// A literal Nx makes into a tensor of a type that cannot hold it, the
// type Nx inferred or the one the code wrote at the call.
.decl literal_outside_type(site: symbol, position: number, kind: symbol, text: symbol, start: number, name: symbol)
literal_outside_type(site, position, kind, text, start, name) :-
  made_as(site, position, text, start, name, how),
  term_spelling(text, start, spelled),
  number_misfit(spelled, name, outcome),
  misread_kind(how, outcome, kind).

// The kind of a literal a type cannot hold, by where the type comes from
// and what Nx makes of the literal. An inferred type is s32, for an
// integer, so it only wraps.
.decl misread_kind(how: symbol, outcome: symbol, kind: symbol)
misread_kind("inferred", "wraps", "integer_past_s32").
misread_kind("written", "wraps", "literal_wraps").
misread_kind("written", "overflows", "literal_overflows").
misread_kind("written", "flushes", "literal_flushes").
misread_kind("written", "not_integer", "float_as_integer").

// ── Words ──────────────────────────────────────────────────────────

// A scalar literal Nx makes into a tensor, the type it makes it in, and
// `how` that type comes to it:
//
//   * "inferred": an integer operand of an Nx call, which Nx types s32
//     before it merges the operands' types, and an integer in data
//     `Nx.tensor/1,2` is given with no type and no float, which it types
//     s32 too;
//   * "written": an element of data made in a type the call writes.
//
// A literal operand is a term the rules hold at the call: a positive
// integer that fits s32 they hold as a size instead, and it fits.
.decl made_as(site: symbol, position: number, text: symbol, start: number, name: symbol, how: symbol)
made_as(site, position, text, start, "s32", "inferred") :-
  inferred_operand(site, position),
  site_active(context, site),
  argument_value(context, site, position, $Term(text, start)),
  term_spelling(text, start, spelled),
  written_number(spelled, "kind", "integer").
made_as(site, 0, text, element, "s32", "inferred") :-
  untyped_data(site, text, data),
  !data_holds_float(text, data),
  data_element(text, data, element),
  term_spelling(text, element, spelled),
  written_number(spelled, "kind", "integer").
made_as(site, 0, text, element, name, "written") :-
  typed_data(site, text, data, name),
  data_element(text, data, element).

// An argument Nx makes a tensor of in the type it infers for a number:
// an operand of an Nx call (`operand_slot`), but a creation's data, which
// has a rule of its own, and the tensor of `Nx.as_type/2` or
// `Nx.bitcast/2`, whose number takes or keeps the bits of the type given;
// and the bounds of `Nx.Random`'s samplers, which a `:type` does not
// widen either.
.decl inferred_operand(site: symbol, position: number)
inferred_operand(site, position) :-
  operation_site(site, operation, arity),
  operand_slot(operation, arity, _, position),
  !nx_argument(operation, arity, 0, "data"),
  operation != "Nx.as_type",
  operation != "Nx.bitcast".
inferred_operand(site, position) :-
  operation_site(site, operation, arity),
  match("Nx\\.Random\\.(randint|uniform|normal)(_split)?", operation),
  arity >= 3,
  position = range(1, 3).

// Literal data a creation is handed, by the term it starts at: the data
// of `Nx.tensor/1,2` or a shorthand (`Nx.u8/1`), and the number of
// `Nx.as_type/2`. A term the rules hold there, or a positive integer
// written at the call, which they hold as a size.
.decl data_given(context: Context, site: symbol, text: symbol, data: number)
data_given(context, site, text, data) :-
  data_site(site),
  site_active(context, site),
  argument_value(context, site, 0, $Term(text, data)).
data_given(context, site, text, 0) :-
  data_site(site),
  argument_literal(site, 0, text),
  term_size(text, 0, _),
  site_active(context, site).

.decl data_site(site: symbol)
data_site(site) :- operation_site(site, operation, arity), nx_argument(operation, arity, 0, "data").
data_site(site) :- operation_site(site, "Nx.as_type", 2).

// Data `Nx.tensor/1,2` is given with no type, which it types by what the
// data holds: s32 for integers, f32 where any element is a float.
.decl untyped_data(site: symbol, text: symbol, data: number)
untyped_data(site, text, data) :-
  data_given(_, site, text, data),
  operation_site(site, "Nx.tensor", _),
  option_absent(site, "type").

// Data made in a type the call writes: a shorthand's own (`Nx.u8/1`),
// `Nx.tensor/2`'s `:type`, and the type `Nx.as_type/2` makes a number.
.decl typed_data(site: symbol, text: symbol, data: number, name: symbol)
typed_data(site, text, data, name) :-
  data_given(_, site, text, data),
  operation_site(site, operation, 1),
  type_shorthand(name),
  operation = cat("Nx.", name).
typed_data(site, text, data, name) :-
  data_given(context, site, text, data),
  operation_site(site, "Nx.tensor", 2),
  type_named(context, site, name).
typed_data(site, text, data, name) :-
  data_given(context, site, text, data),
  operation_site(site, "Nx.as_type", 2),
  term_scalar(text, data),
  type_named(context, site, name).

// The type a call in a context is given, by name (`u8`).
.decl type_named(context: Context, site: symbol, name: symbol)
type_named(context, site, name) :-
  type_term(context, site, _, text, start),
  term_spelling(text, start, spelled),
  type_spelling(spelled, name, _).

// The terms of literal data: its own, and its lists' elements, at any
// depth. Their numbers are asked about.
.decl data_element(text: symbol, data: number, start: number)
data_element(text, data, data) :- data_given(_, _, text, data).
data_element(text, data, child) :-
  data_element(text, data, start),
  term_list(text, start),
  term_child(text, start, _, child).
number_asked(spelled) :- data_element(text, _, start), term_spelling(text, start, spelled).

// Data with a float in it, or `:nan` or an infinity, which Nx takes as
// one: it types the data f32 when given no type.
.decl data_holds_float(text: symbol, data: number)
data_holds_float(text, data) :-
  data_element(text, data, start),
  term_spelling(text, start, spelled),
  written_number(spelled, "kind", kind),
  kind != "integer".

// ══ Short atom types ════════════════════════════════════════════════

// A type written as a short atom (`:f32`) handed where Nx matches only
// the tuple form: an `Nx.Type` function raises for it or answers as for
// another type, and `Nx.Random.gumbel`'s `:type` reaches `Nx.Type.float?/1`
// unnormalized, which raises.
.decl atom_type_handed(site: symbol, position: number, spelled: symbol, kind: symbol)
atom_type_handed(site, position, spelled, kind) :-
  tuple_type_argument(site, function, position),
  type_argument_spelled(site, position, spelled),
  short_type_atom(spelled, name),
  answers_atom(function, name, kind).
atom_type_handed(site, -1, spelled, "atom_type_rejected") :-
  samples_gumbel(site),
  type_given_spelled(site, -1, spelled),
  short_type_atom(spelled, _).

// ── Words ──────────────────────────────────────────────────────────

// A type argument of a call of an `Nx.Type` function that matches a type
// only as a tuple, and the function: the first argument of every one
// (`Nx.Type.normalize!/1` takes either form), and the second of
// `merge/2`.
.decl tuple_type_argument(site: symbol, function: symbol, position: number)
tuple_type_argument(site, name, 0) :-
  remote_call(site, _, "Nx.Type", name, _),
  atom_type_outcome(functions, _, _),
  match(functions, name).
tuple_type_argument(site, "merge", 1) :- remote_call(site, _, "Nx.Type", "merge", 2).

// What an `Nx.Type` function does with a short atom type, by a pattern of
// the functions and one of the types:
//
//   * "atom_type_rejected": no clause matches it, or the function hands it
//     to one where none does (`to_floating/1` to `merge/2`, `min_binary/1`
//     to `min_finite_binary/1`), for any type;
//   * "atom_type_misread": a catch-all clause answers as if for another
//     type, for the types that answer is wrong for: `to_complex/1` gives
//     `{:c, 64}`, `to_real/1` `{:f, 32}`, `to_aggregate/1` the atom as it
//     is, `infinite_float?/1` false and `merge_number/2` `{:f, 32}` (for
//     an integer type too where the number is an integer, which is left
//     out: its tuple gives `{:f, 32}` for a float).
.decl atom_type_outcome(functions: symbol, names: symbol, kind: symbol)
atom_type_outcome("integer\\?|float\\?|complex\\?|to_string|to_floating|merge|cast_number!|.*_binary", ".*", "atom_type_rejected").
atom_type_outcome("to_complex", "f64|c128", "atom_type_misread").
atom_type_outcome("to_real", "f8|f16|bf16|f64|c128|f8_e4m3fn", "atom_type_misread").
atom_type_outcome("to_aggregate", "[su](2|4|8|16)|u64", "atom_type_misread").
atom_type_outcome("infinite_float\\?", "f8|f16|bf16|f32|f64|c64|c128", "atom_type_misread").
atom_type_outcome("merge_number", "f(8|16|64)|bf16|c64|c128", "atom_type_misread").

// What a type argument may be, spelled: written at the call, or a term
// the rules hold there.
.decl type_argument_spelled(site: symbol, position: number, spelled: symbol)
type_argument_spelled(site, position, spelled) :-
  tuple_type_argument(site, _, position),
  flow_argument(site, _, position, "literal", spelled).
type_argument_spelled(site, position, spelled) :-
  tuple_type_argument(site, _, position),
  site_active(context, site),
  flow_argument(site, function, position, kind, source),
  kind != "literal",
  value_of(context, function, kind, source, $Term(text, start)),
  term_spelling(text, start, spelled).

// The outcome for a function and a type, by the patterns above.
.decl answers_atom(function: symbol, name: symbol, kind: symbol) inline
answers_atom(function, name, kind) :-
  atom_type_outcome(functions, names, kind),
  match(functions, function),
  match(names, name).

// A type spelled as a short atom, and its name.
.decl short_type_atom(spelled: symbol, name: symbol)
short_type_atom(spelled, name) :- type_spelling(spelled, name, _), match(":.*", spelled).

// A call of `Nx.Random.gumbel/2` or `Nx.Random.gumbel_split/2`.
.decl samples_gumbel(site: symbol)
samples_gumbel(site) :-
  operation_site(site, operation, _),
  match("Nx\\.Random\\.gumbel(_split)?", operation).

// ══ Types Nx does not have ══════════════════════════════════════════

// A call given a type Nx does not have, an atom or a tuple
// (`:float32`, `{:f, 128}`): Nx raises "invalid numerical type" (or,
// through `Nx.Random.gumbel`'s `:type`, a FunctionClauseError). nil, true
// and false are left out: some calls take them for their default type.
.decl invalid_type(site: symbol, position: number, spelled: symbol)
invalid_type(site, position, spelled) :-
  type_given_spelled(site, position, spelled),
  written_as_type(spelled),
  !type_spelling(spelled, _, _).

// ── Words ──────────────────────────────────────────────────────────

// The type a call is given, spelled, in any context.
.decl type_given_spelled(site: symbol, position: number, spelled: symbol)
type_given_spelled(site, position, spelled) :-
  type_term(_, site, position, text, start),
  term_spelling(text, start, spelled).

// A spelling that can only be meant as a type where one is given: an atom
// or a tuple.
.decl written_as_type(spelled: symbol) inline
written_as_type(spelled) :- match("[:{].*", spelled).

// The term a call is given as its type, where the code writes it or it is
// a value the rules hold: the `:type` option of a call that takes one, or
// a type argument (`Nx.as_type/2`, `Nx.Constants.pi/1`). `position` is
// the argument's, -1 for an option.
.decl type_term(context: Context, site: symbol, position: number, text: symbol, start: number)
type_term(context, site, -1, text, start) :-
  takes_type_option(site),
  option(site, "type", text, start),
  site_active(context, site).
type_term(context, site, -1, text, start) :-
  takes_type_option(site),
  option_pair(site, "type", function, kind, source),
  kind != "literal",
  site_active(context, site),
  value_of(context, function, kind, source, $Term(text, start)).
type_term(context, site, position, text, start) :-
  type_position(site, position),
  site_active(context, site),
  flow_argument(site, function, position, kind, source),
  value_of(context, function, kind, source, $Term(text, start)).
type_term(context, site, -1, text, start) :-
  takes_type_option(site),
  handed_options(context, site, text, list),
  term_keyword(text, list, "type", start).

// The calls whose `:type` option is a tensor type and whose options the
// options above read.
.decl takes_type_option(site: symbol)
takes_type_option(site) :-
  operation_site(site, operation, _),
  match("Nx\\.(tensor|iota|eye|argmax|argmin|argsort|fill|linspace|reduce|Random\\.(randint|uniform|normal|gumbel)(_split)?)", operation).
